---
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BxLearn</title>
  <link rel="icon" type="image/webp" href="https://cdn.prod.website-files.com/698490cbbe249d5a3fac58e0/69a040f353af3359b1e20f61_Bx_Webclip.webp" />
  <!-- Google Fonts: Host Grotesk (SemiBold 600) & Google Sans / DM Sans fallback -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Host+Grotesk:wght@500;600;700&family=Google+Sans:wght@400;500;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script is:inline src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href={`${base}/styles.css`} />
</head>
<body>
  <div id="app" class="app-shell">
    <!-- Minimal Top Navigation Bar -->
    <header class="topbar">
      <div class="topbar-left">
        <button type="button" id="btn-back-library" class="icon-btn hidden" title="Back to Library">
          <i data-lucide="arrow-left"></i>
        </button>

        <div class="brand" id="brand-home">
          <img src="https://cdn.prod.website-files.com/698490cbbe249d5a3fac58e0/6afdbbadb62a820ece278dd6_BxSoftware_Logo_Wordmark_Color.svg" alt="BxSoftware" class="brand-wordmark" />
        </div>

        <div id="editor-breadcrumb" class="editor-breadcrumb hidden">
          <span id="editor-folder-pill" class="folder-pill" title="Folder">
            <i data-lucide="folder"></i>
            <span id="editor-folder-label">Root</span>
          </span>
          <span class="breadcrumb-sep">/</span>
          <input id="editor-demo-title" type="text" class="inline-title-input" placeholder="Untitled walkthrough..." />
        </div>
      </div>

      <div class="topbar-center" id="editor-mode-switcher-wrap">
        <div id="editor-mode-switcher" class="segmented-control hidden">
          <button type="button" class="seg-btn active" data-mode="edit">
            <i data-lucide="mouse-pointer-click"></i>
            <span>Edit</span>
          </button>
          <button type="button" id="btn-mode-preview" class="seg-btn" data-mode="preview">
            <i data-lucide="play"></i>
            <span>Preview</span>
          </button>
        </div>
      </div>

      <div class="topbar-right">
        <span id="save-status" class="save-status hidden" title="Changes saved">
          <i data-lucide="check"></i>
        </span>
        <button type="button" id="btn-share-preview" class="btn btn-sm btn-outline hidden" title="Copy shareable preview link">
          <i data-lucide="share-2"></i>
          <span>Share</span>
        </button>
        <button type="button" id="btn-webflow-hub" class="icon-btn" title="Webflow Embed & Export">
          <i data-lucide="code-2"></i>
        </button>
        <button type="button" id="btn-new-demo-top" class="btn btn-sm btn-primary" title="New Walkthrough">
          <i data-lucide="plus"></i>
          <span>New</span>
        </button>
        <button type="button" id="btn-logout" class="icon-btn" title="Sign Out">
          <i data-lucide="log-out"></i>
        </button>
      </div>
    </header>

    <!-- VIEW 1: LIBRARY & FOLDER HIERARCHY EXPLORER -->
    <main id="view-library" class="workspace-layout">
      <!-- Left Folder Hierarchy Sidebar -->
      <aside class="folder-sidebar">
        <div class="sidebar-header">
          <h2>Folders</h2>
          <button type="button" id="btn-new-folder" class="icon-btn" title="New Folder">
            <i data-lucide="folder-plus"></i>
          </button>
        </div>

        <div class="folder-nav-list">
          <button type="button" id="nav-all-demos" class="folder-row active" data-folder="__ALL__">
            <div class="folder-row-left">
              <i data-lucide="layout-grid" class="folder-icon"></i>
              <span class="folder-name">All Walkthroughs</span>
            </div>
            <span id="count-all-demos" class="folder-count">0</span>
          </button>

          <button type="button" id="nav-root-demos" class="folder-row" data-folder="">
            <div class="folder-row-left">
              <i data-lucide="inbox" class="folder-icon"></i>
              <span class="folder-name">Unfiled</span>
            </div>
            <span id="count-root-demos" class="folder-count">0</span>
          </button>
        </div>

        <div class="sidebar-divider"></div>

        <div id="folder-tree" class="folder-tree"></div>
      </aside>

      <!-- Main Demo Directory Content -->
      <section class="library-content">
        <div class="library-toolbar">
          <div class="current-folder-heading">
            <div class="folder-breadcrumbs" id="library-breadcrumbs"></div>
            <div class="folder-title-row">
              <h1 id="current-folder-title">All Walkthroughs</h1>
              <div id="current-folder-actions" class="folder-header-actions hidden">
                <button type="button" id="btn-add-subfolder" class="icon-btn" title="New Subfolder">
                  <i data-lucide="folder-plus"></i>
                </button>
                <button type="button" id="btn-rename-folder" class="icon-btn" title="Rename Folder">
                  <i data-lucide="pencil"></i>
                </button>
                <button type="button" id="btn-delete-folder" class="icon-btn text-danger" title="Delete Folder">
                  <i data-lucide="trash-2"></i>
                </button>
              </div>
            </div>
          </div>

          <div class="library-controls">
            <div class="search-box">
              <i data-lucide="search"></i>
              <input id="search-demos" type="text" placeholder="Search..." />
            </div>
          </div>
        </div>

        <!-- Subfolders strip -->
        <div id="subfolders-section" class="subfolders-section hidden">
          <div id="subfolders-grid" class="subfolders-grid"></div>
        </div>

        <!-- Demos Grid -->
        <div class="demos-section">
          <div id="demos-grid" class="demos-grid"></div>
        </div>
      </section>
    </main>

    <!-- VIEW 2: WALKTHROUGH EDITOR & INTERACTIVE PLAYER -->
    <main id="view-editor" class="editor-layout hidden">
      <!-- Left Panel: Compact Steps List -->
      <aside class="steps-sidebar">
        <div class="panel-header">
          <h2>Steps</h2>
          <div class="panel-header-actions">
            <button type="button" id="btn-undo-step" class="icon-btn" title="Undo (⌘Z)" disabled>
              <i data-lucide="undo-2"></i>
            </button>
            <div class="add-step-dropdown">
              <button type="button" id="btn-add-step-menu" class="btn btn-xs btn-primary add-step-trigger" title="Add step or explainer">
                <i data-lucide="plus"></i>
                <span>Add</span>
                <i data-lucide="chevron-down"></i>
              </button>
              <div id="add-step-menu" class="add-step-menu hidden">
                <button type="button" id="btn-add-step" class="add-step-menu-item">
                  <i data-lucide="mouse-pointer-click"></i>
                  <span>Hotspot Step</span>
                </button>
                <button type="button" id="btn-add-text-step" class="add-step-menu-item">
                  <i data-lucide="layout-template"></i>
                  <span>Text Page</span>
                </button>
                <button type="button" id="btn-add-explainer-step" class="add-step-menu-item">
                  <i data-lucide="book-open"></i>
                  <span>Explainer Tooltip</span>
                </button>
                <div class="add-step-menu-divider"></div>
                <label for="screenshot-steps-input" class="add-step-menu-item">
                  <i data-lucide="image-plus"></i>
                  <span>Upload Screenshot(s)</span>
                </label>
                <button type="button" id="btn-sidebar-wf-assets" class="add-step-menu-item">
                  <i data-lucide="folder-search"></i>
                  <span>From Webflow Assets</span>
                </button>
              </div>
            </div>
            <input id="screenshot-steps-input" type="file" accept="image/png,image/jpeg,image/webp,image/*" multiple class="hidden" />
          </div>
        </div>

        <div id="steps-list" class="steps-list"></div>

        <div class="steps-sidebar-footer">
          <div class="select-wrap" title="Folder Location">
            <i data-lucide="folder"></i>
            <select id="editor-folder-select"></select>
          </div>
        </div>
      </aside>

      <!-- Center Stage: Video / Screenshot Canvas + Hotspot Overlay + Scrubber Timeline -->
      <section class="stage-area">
        <!-- Empty Video / Screenshot Upload State -->
        <div id="video-upload-empty" class="video-upload-empty hidden">
          <div class="upload-dropzone" id="upload-dropzone">
            <div class="upload-icon-circle">
              <i data-lucide="image-plus"></i>
            </div>
            <h2>Upload Video or Screenshots</h2>
            <p>Drop a recording (MP4, MOV) or 1+ screenshots (PNG, JPG, WebP), or paste (⌘V).</p>
            <div class="upload-actions">
              <label class="btn btn-sm btn-primary" for="video-file-input">
                <i data-lucide="video"></i>
                <span>Upload Video</span>
              </label>
              <input id="video-file-input" type="file" accept="video/mp4,video/webm,video/quicktime,video/*" class="hidden" />
              <label class="btn btn-sm btn-secondary" for="screenshots-empty-input">
                <i data-lucide="image"></i>
                <span>Upload Screenshots</span>
              </label>
              <input id="screenshots-empty-input" type="file" accept="image/png,image/jpeg,image/webp,image/*" multiple class="hidden" />
              <button type="button" id="btn-browse-webflow-assets" class="btn btn-sm btn-outline" title="Pick images or videos directly from Webflow Assets">
                <i data-lucide="folder-search"></i>
                <span>Webflow Assets</span>
              </button>
              <button type="button" id="btn-use-sample-video" class="btn btn-sm btn-outline">
                <i data-lucide="sparkles"></i>
                <span>Sample</span>
              </button>
            </div>
            <div class="url-input-row">
              <input id="video-url-input" type="url" placeholder="https://cdn.prod.website-files.com/... (Video or Image URL)" />
              <button type="button" id="btn-set-video-url" class="btn btn-sm btn-secondary">Load</button>
            </div>
          </div>
        </div>

        <!-- Active Stage -->
        <div id="video-stage-container" class="video-stage-container">
          <!-- Constant 16:9 Backdrop Frame + Centered Aspect-Ratio Screen -->
          <div id="stage-viewport-wrap" class="stage-viewport-wrap">
            <div id="stage-backdrop-frame" class="stage-backdrop-frame">
              <div id="stage-media-pane" class="stage-media-pane">
                <div id="video-viewport" class="video-viewport">
                  <div class="viewport-media-clip">
                    <video id="demo-video" playsinline preload="metadata" crossorigin="anonymous"></video>
                    <canvas id="sample-video-canvas" width="1280" height="720" class="sample-video-canvas hidden"></canvas>
                    <img id="demo-step-image" class="demo-step-image hidden" alt="" draggable="false" />
                  </div>

                  <!-- Hotspot & Button Trace Overlay Layer (Locked 1:1 to Media Frame) -->
                  <div id="hotspot-overlay" class="hotspot-overlay edit-cursor"></div>
                </div>
              </div>

              <!-- Full-Stage Text Screen & 50/50 Split Text Column -->
              <div id="stage-screen-overlay" class="stage-screen-overlay hidden"></div>
            </div>
          </div>

          <!-- Minimal Video Timeline & Step Marker Scrubber (Edit Mode) -->
          <div id="timeline-bar" class="timeline-bar">
            <div class="timeline-controls-left">
              <button type="button" id="btn-play-pause" class="icon-btn-round" title="Play / Pause">
                <span id="icon-play-pause-wrap"><i data-lucide="play"></i></span>
              </button>
              <div class="time-readout">
                <span id="time-current">00:00.0</span>
                <span class="time-sep">/</span>
                <span id="time-duration">00:08.0</span>
              </div>
            </div>

            <div class="timeline-track-container">
              <div id="timeline-track" class="timeline-track">
                <div id="timeline-progress" class="timeline-progress"></div>
                <div id="timeline-playhead" class="timeline-playhead"></div>
                <div id="timeline-markers" class="timeline-markers"></div>
              </div>
            </div>

            <div class="timeline-controls-right">
              <button type="button" id="btn-capture-time" class="icon-btn" title="Set current time for selected step">
                <i data-lucide="clock"></i>
              </button>
              <button type="button" id="btn-snap-frame-timeline" class="icon-btn" title="Capture current video frame as screenshot">
                <i data-lucide="camera"></i>
              </button>
              <button type="button" id="btn-add-step-timeline" class="icon-btn" title="Add Hotspot Step at playhead">
                <i data-lucide="map-pin-plus"></i>
              </button>
              <button type="button" id="btn-add-text-timeline" class="icon-btn" title="Add Intro / Text Screen at playhead">
                <i data-lucide="layout-template"></i>
              </button>
              <button type="button" id="btn-add-explainer-timeline" class="icon-btn" title="Add Explainer at playhead (not a step)">
                <i data-lucide="book-open"></i>
              </button>
              <span class="toolbar-v-divider"></span>
              <label class="icon-btn" for="video-file-replace" title="Upload / Replace video file">
                <i data-lucide="upload"></i>
              </label>
              <input id="video-file-replace" type="file" accept="video/mp4,video/webm,video/quicktime,video/*" class="hidden" />
              <button type="button" id="btn-video-url-modal" class="icon-btn" title="Set external video URL">
                <i data-lucide="link"></i>
              </button>
            </div>
          </div>

          <!-- Minimal Interactive Player Dock (Preview Mode) -->
          <div id="preview-player-bar" class="preview-player-bar hidden">
            <div class="preview-bar-left">
              <button type="button" id="btn-preview-restart" class="icon-btn" title="Restart walkthrough">
                <i data-lucide="rotate-ccw"></i>
              </button>
              <span id="preview-status-pill" class="preview-status-pill">
                <span class="status-dot"></span>
                <span id="preview-status-text">Ready</span>
              </span>
            </div>

            <div id="preview-step-dots" class="preview-step-dots"></div>

            <div class="preview-bar-right">
              <button type="button" id="btn-preview-prev" class="icon-btn" title="Previous step">
                <i data-lucide="chevron-left"></i>
              </button>
              <button type="button" id="btn-preview-next" class="icon-btn" title="Next step">
                <i data-lucide="chevron-right"></i>
              </button>
              <button type="button" id="btn-preview-fullscreen" class="icon-btn" title="Fullscreen">
                <i data-lucide="maximize-2"></i>
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- Right Panel: Minimal Step & Hotspot Inspector -->
      <aside id="inspector-sidebar" class="inspector-sidebar">
        <div class="panel-header">
          <div class="inspector-header-left">
            <h2 id="inspector-panel-title">Step</h2>
            <span id="inspector-step-badge" class="step-badge">1 / 3</span>
          </div>
          <button type="button" id="btn-delete-step" class="icon-btn text-danger" title="Delete Step">
            <i data-lucide="trash-2"></i>
          </button>
        </div>

        <div id="inspector-empty" class="inspector-empty hidden">
          <i data-lucide="mouse-pointer-click"></i>
          <p>Select or add a step to configure it.</p>
        </div>

        <div id="inspector-form" class="inspector-form">
          <!-- Step Type Switcher: Hotspot vs Text Screen vs Explainer Tooltip -->
          <div class="form-group">
            <label>Step Type</label>
            <div class="type-pill-group type-pill-group-3" id="step-type-switcher">
              <button type="button" class="type-pill-btn active" data-step-type="hotspot">
                <i data-lucide="mouse-pointer-click"></i>
                <span>Hotspot</span>
              </button>
              <button type="button" class="type-pill-btn" data-step-type="screen">
                <i data-lucide="layout-template"></i>
                <span>Text Page</span>
              </button>
              <button type="button" class="type-pill-btn" data-step-type="explainer">
                <i data-lucide="book-open"></i>
                <span>Explainer</span>
              </button>
            </div>
          </div>

          <!-- Step Screenshot / Frame Control -->
          <div class="form-group">
            <label>Step Screenshot</label>
            <div class="screenshot-inspector-box">
              <div class="screenshot-inspector-actions">
                <label for="step-screenshot-input" class="btn btn-xs btn-outline" title="Upload image for this step">
                  <i data-lucide="image"></i>
                  <span id="step-screenshot-btn-label">Upload Screenshot</span>
                </label>
                <input id="step-screenshot-input" type="file" accept="image/png,image/jpeg,image/webp,image/*" class="hidden" />
                <button type="button" id="btn-inspector-wf-assets" class="icon-btn" title="Pick from Webflow Assets">
                  <i data-lucide="folder-search"></i>
                </button>
                <button type="button" id="btn-snap-video-frame" class="icon-btn" title="Snap current video frame as screenshot">
                  <i data-lucide="camera"></i>
                </button>
                <button type="button" id="btn-clear-step-screenshot" class="icon-btn text-danger hidden" title="Remove screenshot (use video timeline)">
                  <i data-lucide="x"></i>
                </button>
              </div>
              <span id="step-screenshot-status" class="screenshot-status-hint">Or press ⌘V to paste screenshot</span>
            </div>
          </div>

          <div id="screen-kicker-group" class="form-group hidden">
            <label for="step-kicker-input">Label / Badge</label>
            <input id="step-kicker-input" type="text" placeholder="e.g. Welcome • Product Tour" />
          </div>

          <div class="form-group">
            <label for="step-title-input">Heading</label>
            <input id="step-title-input" type="text" placeholder="Step heading..." />
          </div>

          <div class="form-group">
            <label for="step-body-input">Description</label>
            <textarea id="step-body-input" rows="3" placeholder="Explain this step..."></textarea>
          </div>

          <div class="form-row-2">
            <div id="step-timestamp-group" class="form-group">
              <label for="step-timestamp-input">Pause at (s)</label>
              <div class="input-with-btn">
                <input id="step-timestamp-input" type="number" step="0.1" min="0" />
                <button type="button" id="btn-use-curr-time" class="icon-btn" title="Capture current video time">
                  <i data-lucide="clock"></i>
                </button>
              </div>
            </div>

            <div class="form-group">
              <label for="step-btn-text-input">Button</label>
              <input id="step-btn-text-input" type="text" placeholder="Next" />
            </div>
          </div>

          <!-- Hotspot-only controls -->
          <div id="hotspot-only-fields" class="form-row-2">
            <div class="form-group">
              <label for="step-placement-select">Tooltip</label>
              <select id="step-placement-select">
                <option value="auto">Auto</option>
                <option value="right">Right</option>
                <option value="left">Left</option>
                <option value="bottom">Bottom</option>
                <option value="top">Top</option>
              </select>
            </div>
            <div class="form-group">
              <label for="step-style-select">Hotspot Style</label>
              <select id="step-style-select">
                <option value="beacon">Beacon</option>
                <option value="ring">Ring</option>
                <option value="trace">Button Trace</option>
              </select>
            </div>
          </div>

          <!-- Hotspot tooltip visibility (Beacon / Ring / Trace) -->
          <div id="hotspot-tooltip-toggle" class="form-group checkbox-group">
            <label class="checkbox-label">
              <input id="step-show-tooltip" type="checkbox" checked />
              <span>Show tooltip card</span>
            </label>
          </div>

          <!-- Button Trace extra hint -->
          <div id="trace-only-fields" class="form-group trace-inspector-box hidden">
            <div class="trace-inspector-hint">
              <i data-lucide="scan-line"></i>
              <span>Drag the box or its corner handles on the stage to trace any button.</span>
            </div>
          </div>

          <!-- Text Screen-only controls -->
          <div id="screen-only-fields" class="form-group hidden" style="gap: 10px;">
            <div class="form-group">
              <label>Text Screen Layout</label>
              <div class="type-pill-group" id="step-screen-layout-switcher">
                <button type="button" class="type-pill-btn active" data-screen-layout="default">
                  <i data-lucide="layout-template"></i>
                  <span>Default (Full)</span>
                </button>
                <button type="button" class="type-pill-btn" data-screen-layout="split">
                  <i data-lucide="columns-2"></i>
                  <span>50/50 Split</span>
                </button>
              </div>
            </div>

            <div class="form-group">
              <label for="step-backdrop-select">Screen Backdrop</label>
              <select id="step-backdrop-select">
                <option value="blur">Blurred Media</option>
                <option value="dark">Dark Navy (#00182C)</option>
                <option value="light">Minimal Light</option>
              </select>
            </div>
          </div>

          <!-- Card Field Visibility Toggles -->
          <div id="card-visibility-fields" class="form-group">
            <label>Visible Elements</label>
            <div class="visibility-grid">
              <label class="checkbox-label">
                <input id="step-show-kicker" type="checkbox" checked />
                <span>Label / Counter</span>
              </label>
              <label class="checkbox-label">
                <input id="step-show-title" type="checkbox" checked />
                <span>Heading</span>
              </label>
              <label class="checkbox-label">
                <input id="step-show-body" type="checkbox" checked />
                <span>Description</span>
              </label>
              <label class="checkbox-label">
                <input id="step-show-primary-btn" type="checkbox" checked />
                <span>Primary button</span>
              </label>
              <label class="checkbox-label">
                <input id="step-show-back-btn" type="checkbox" checked />
                <span>Back button</span>
              </label>
              <label class="checkbox-label" id="step-show-progress-wrap">
                <input id="step-show-progress" type="checkbox" checked />
                <span>Progress bar</span>
              </label>
            </div>
          </div>

          <div class="form-group">
            <label for="step-cta-url-input">CTA Link (optional)</label>
            <input id="step-cta-url-input" type="url" placeholder="https://..." />
          </div>

          <div id="hotspot-advance-group" class="form-group checkbox-group">
            <label class="checkbox-label">
              <input id="step-advance-hotspot" type="checkbox" checked />
              <span>Advance when hotspot is clicked</span>
            </label>
          </div>

          <span id="coord-x-val" class="hidden"></span>
          <span id="coord-y-val" class="hidden"></span>
        </div>
      </aside>
    </main>

    <!-- MODAL: WEBFLOW EXPORT & EMBED -->
    <div id="modal-webflow" class="modal-backdrop hidden">
      <div class="modal-card modal-lg">
        <div class="modal-header">
          <div class="modal-title-group">
            <div class="modal-icon">
              <i data-lucide="code-2"></i>
            </div>
            <div>
              <h2>Webflow Embed</h2>
              <p>Copy &amp; paste into a Webflow Custom Code Embed element.</p>
            </div>
          </div>
          <button type="button" id="btn-close-webflow-modal" class="icon-btn">
            <i data-lucide="x"></i>
          </button>
        </div>

        <div class="modal-tabs">
          <button type="button" class="modal-tab active" data-wf-tab="single">
            <i data-lucide="play-square"></i>
            <span>Single Demo</span>
          </button>
          <button type="button" class="modal-tab" data-wf-tab="hub">
            <i data-lucide="folder-tree"></i>
            <span>Folder Hub</span>
          </button>
          <button type="button" class="modal-tab" data-wf-tab="download">
            <i data-lucide="download"></i>
            <span>Download HTML</span>
          </button>
        </div>

        <div class="modal-body">
          <div id="wf-config-single" class="wf-tab-section">
            <div class="form-row-2">
              <div class="form-group">
                <label for="wf-select-demo">Walkthrough</label>
                <select id="wf-select-demo"></select>
              </div>
              <div class="form-group">
                <label for="wf-video-override">Hosted Video URL (Webflow Asset / CDN)</label>
                <input id="wf-video-override" type="url" placeholder="https://cdn.prod.website-files.com/.../video.mp4" />
              </div>
            </div>
          </div>

          <div id="wf-config-hub" class="wf-tab-section hidden">
            <p class="dialog-subtitle">Embeds the full folder hierarchy and walkthrough player into any Webflow page.</p>
          </div>

          <div id="wf-config-download" class="wf-tab-section hidden">
            <div class="download-btn-row">
              <button type="button" id="btn-download-single-html" class="btn btn-sm btn-primary">
                <i data-lucide="file-code"></i>
                <span>Selected Demo (.html)</span>
              </button>
              <button type="button" id="btn-download-hub-html" class="btn btn-sm btn-outline">
                <i data-lucide="folder-down"></i>
                <span>Full Folder Hub (.html)</span>
              </button>
            </div>
          </div>

          <div id="wf-base64-warning" class="wf-base64-warning hidden">
            <span>Some screenshots are embedded as long base64 data. Connect Webflow Assets or convert them to short CDN URLs.</span>
            <button type="button" id="btn-upload-base64-wf" class="btn btn-xs btn-outline">Upload to Webflow Assets</button>
          </div>

          <div class="code-box-wrap">
            <div class="code-box-header">
              <span id="wf-code-label">Embed Snippet</span>
              <button type="button" id="btn-copy-wf-code" class="btn btn-xs btn-primary">
                <i data-lucide="copy"></i>
                <span>Copy</span>
              </button>
            </div>
            <textarea id="wf-code-output" class="code-textarea" readonly spellcheck="false"></textarea>
          </div>
        </div>
      </div>
    </div>

    <!-- MODAL: WEBFLOW ASSETS BROWSER -->
    <div id="modal-webflow-assets" class="modal-backdrop hidden">
      <div class="modal-card modal-lg wf-assets-modal">
        <div class="modal-header">
          <div class="modal-title-group">
            <div class="modal-icon">
              <i data-lucide="folder-search"></i>
            </div>
            <div>
              <h2>Webflow Site Assets</h2>
              <p>Connect your Webflow Site API Token to browse and insert screenshots or videos from Webflow Assets.</p>
            </div>
          </div>
          <button type="button" id="btn-close-wf-assets-modal" class="icon-btn">
            <i data-lucide="x"></i>
          </button>
        </div>

        <div class="modal-body">
          <!-- Webflow API Connection Bar -->
          <div class="wf-assets-connect-box">
            <div class="form-row-2">
              <div class="form-group">
                <label for="wf-assets-token-input">Webflow API Token (assets:read)</label>
                <input id="wf-assets-token-input" type="password" placeholder="Paste token from Site Settings → API Access..." />
              </div>
              <div class="form-group">
                <label for="wf-assets-site-id-input">Site (Auto-detected or Site ID)</label>
                <div class="input-with-btn">
                  <select id="wf-assets-site-select" class="hidden"></select>
                  <input id="wf-assets-site-id-input" type="text" placeholder="Auto-detects on Connect (or paste Site ID)" />
                  <button type="button" id="btn-wf-assets-connect" class="btn btn-xs btn-primary">
                    <i data-lucide="refresh-cw"></i>
                    <span>Connect</span>
                  </button>
                </div>
              </div>
            </div>
            <div id="wf-assets-status" class="wf-assets-status">
              Generate a Site API Token in Webflow: <strong>Site Settings → Apps &amp; Integrations → API Access</strong> (enable <code>assets:read</code> and <code>sites:read</code>).
            </div>
          </div>

          <!-- Filter & Search Row -->
          <div class="wf-assets-toolbar">
            <div class="search-box" style="flex:1; width:auto;">
              <i data-lucide="search"></i>
              <input id="wf-assets-search" type="text" placeholder="Filter Webflow assets by filename..." />
            </div>
            <select id="wf-assets-folder-select" class="wf-folder-filter">
              <option value="__ALL__">All Asset Folders</option>
            </select>
          </div>

          <!-- Assets Thumbnail Grid -->
          <div id="wf-assets-grid" class="wf-assets-grid">
            <div class="wf-assets-empty">
              <i data-lucide="cloud"></i>
              <p>Enter your Webflow API Token above and click <strong>Connect</strong> to load your site's assets.</p>
            </div>
          </div>

          <!-- Footer Actions -->
          <div class="wf-assets-footer">
            <span id="wf-assets-selected-count" class="wf-selected-label">0 assets selected</span>
            <div style="display:flex; gap:8px;">
              <button type="button" id="btn-cancel-wf-assets" class="btn btn-sm btn-ghost">Cancel</button>
              <button type="button" id="btn-wf-assets-insert" class="btn btn-sm btn-primary" disabled>
                <i data-lucide="check"></i>
                <span>Add Selected to Walkthrough</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- MODAL: SIMPLE DIALOG -->
    <div id="modal-dialog" class="modal-backdrop hidden">
      <div class="modal-card modal-sm">
        <div class="modal-header">
          <h2 id="dialog-title">New Folder</h2>
          <button type="button" id="btn-close-dialog" class="icon-btn">
            <i data-lucide="x"></i>
          </button>
        </div>
        <form id="dialog-form" class="modal-body">
          <p id="dialog-subtitle" class="dialog-subtitle"></p>
          <div id="dialog-input-group" class="form-group">
            <label id="dialog-label" for="dialog-input">Name</label>
            <input id="dialog-input" type="text" />
          </div>
          <div id="dialog-parent-group" class="form-group hidden">
            <label for="dialog-parent-select">Folder</label>
            <select id="dialog-parent-select"></select>
          </div>
          <div class="modal-actions">
            <button type="button" id="btn-cancel-dialog" class="btn btn-sm btn-ghost">Cancel</button>
            <button type="submit" id="btn-confirm-dialog" class="btn btn-sm btn-primary">Confirm</button>
          </div>
        </form>
      </div>
    </div>

    <!-- STUDIO LOGIN GATE (Only for the BxLearn Studio App, never in Webflow embeds) -->
    <div id="auth-login-screen" class="auth-login-screen hidden">
      <div class="auth-login-card">
        <div class="auth-brand">
          <img src="https://cdn.prod.website-files.com/698490cbbe249d5a3fac58e0/6afdbbadb62a820ece278dd6_BxSoftware_Logo_Wordmark_Color.svg" alt="BxSoftware" class="auth-brand-wordmark" />
          <p>Sign in to manage and create interactive walkthroughs.</p>
        </div>

        <form id="auth-login-form" class="auth-login-form">
          <div class="form-group">
            <label for="login-username">Email / Username</label>
            <input id="login-username" type="email" autocomplete="username" placeholder="Email" required />
          </div>

          <div class="form-group">
            <label for="login-password">Password</label>
            <input id="login-password" type="password" autocomplete="current-password" placeholder="••••••" required />
          </div>

          <div id="login-error" class="auth-login-error hidden">
            Invalid username or password.
          </div>

          <button type="submit" class="btn btn-primary auth-submit-btn">
            <span>Sign In</span>
            <i data-lucide="arrow-right"></i>
          </button>
        </form>
      </div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toast-container" class="toast-container"></div>
  </div>

  <script is:inline define:vars={{ base }}>
    window.__BXLEARN_BASE__ = base;
  </script>
  <script is:inline src={`${base}/app.js`}></script>
</body>
</html>
